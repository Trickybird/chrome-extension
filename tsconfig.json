{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*.js", "test/**/*.mjs", "tools/**/*.mjs"]
}
